rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isVerifiedGoogleUser() {
      return isSignedIn() &&
        'email_verified' in request.auth.token &&
        request.auth.token.email_verified == true;
    }

    function isPhonePasswordUser() {
      return isSignedIn() &&
        'firebase' in request.auth.token &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        'email' in request.auth.token &&
        request.auth.token.email.matches('^ph_[0-9]{10,15}(\\.r[0-9]{1,3})?@fdmis\\.local$');
    }

    function isPasswordAccountUser() {
      return isSignedIn() &&
        'firebase' in request.auth.token &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        'email' in request.auth.token &&
        request.auth.token.email.size() >= 3;
    }

    function isVerifiedUser() {
      return isVerifiedGoogleUser() || isPasswordAccountUser();
    }

    function isBootstrappedEmail() {
      return isVerifiedGoogleUser() &&
        'email' in request.auth.token &&
        request.auth.token.email == 'abdulbasirnuuman01@gmail.com';
    }

    function isFullControlAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrappedEmail()
      );
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCallerActive(u) {
      return u != null && u.status == 'ACTIVE' && u.sessionRevoked != true;
    }

    function hasActiveUser() {
      return isVerifiedUser() && isCallerActive(callerDoc());
    }

    function isVerificationOfficerFor(lgaId, wardId) {
      let u = callerDoc();
      return isCallerActive(u) && u.role == 'VERIFICATION_OFFICER' && (
        u.assignedLgaId == '' ||
        (u.assignedLgaId == lgaId && (u.assignedWardId == '' || u.assignedWardId == wardId))
      );
    }

    function canReadInArea(lgaId, wardId, puId, ownerUid) {
      let u = callerDoc();
      return isCallerActive(u) && (
        (u.role == 'FUNTUA_SUPER_ADMIN' && lgaId == 'funtua') ||
        (u.role == 'DANDUME_SUPER_ADMIN' && lgaId == 'dandume') ||
        (u.role == 'VERIFICATION_OFFICER' && (
          u.assignedLgaId == '' ||
          (u.assignedLgaId == lgaId && (u.assignedWardId == '' || u.assignedWardId == wardId))
        )) ||
        (u.role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && wardId.size() > 0 && u.assignedWardId == wardId) ||
        (u.role == 'POLLING_UNIT_AGENT' && puId.size() > 0 && u.assignedPollingUnitId == puId) ||
        ownerUid == request.auth.uid
      );
    }

    function isLgaAdminFor(lgaId) {
      let u = callerDoc();
      return isCallerActive(u) && (
        (u.role == 'FUNTUA_SUPER_ADMIN' && lgaId == 'funtua') ||
        (u.role == 'DANDUME_SUPER_ADMIN' && lgaId == 'dandume')
      );
    }

    function isWardCoordFor(wardId) {
      let u = callerDoc();
      return isCallerActive(u) && u.role == 'WARD_COORDINATOR' && wardId.size() > 0 && u.assignedWardId == wardId;
    }

    function isOpsOfficerFor(wardId) {
      let u = callerDoc();
      return isCallerActive(u) && u.role == 'OPERATIONS_OFFICER' && wardId.size() > 0 && u.assignedWardId == wardId;
    }

    function isPuAgentFor(puId) {
      let u = callerDoc();
      return isCallerActive(u) && u.role == 'POLLING_UNIT_AGENT' && puId.size() > 0 && u.assignedPollingUnitId == puId;
    }

    function canVerifyScope(lgaId, wardId) {
      return isFullControlAdmin() ||
        isLgaAdminFor(lgaId) ||
        isVerificationOfficerFor(lgaId, wardId);
    }

    function isValidLgaId(lgaId) {
      return lgaId in ['funtua', 'dandume'];
    }

    function isValidRole(role) {
      return role in [
        'FULL_CONTROL_ADMIN',
        'FUNTUA_SUPER_ADMIN',
        'DANDUME_SUPER_ADMIN',
        'VERIFICATION_OFFICER',
        'OPERATIONS_OFFICER',
        'WARD_COORDINATOR',
        'POLLING_UNIT_AGENT',
        'ORDINARY_USER',
        'PENDING'
      ];
    }

    function isValidAccountStatus(status) {
      return status in ['ACTIVE', 'PENDING_APPROVAL', 'SUSPENDED'];
    }

    function isValidPuStatus(status) {
      return status in [
        'NOT_STARTED',
        'AGENT_ASSIGNED',
        'AGENT_CHECKED_IN',
        'MATERIALS_ARRIVED',
        'VOTING_STARTED',
        'VOTING_IN_PROGRESS',
        'VOTING_COMPLETED',
        'COUNTING_STARTED',
        'RESULT_SUBMITTED',
        'RESULT_UNDER_REVIEW',
        'RESULT_VERIFIED',
        'INCIDENT_REPORTED',
        'COMMUNICATION_LOST'
      ];
    }

    function isValidUrgency(urgency) {
      return urgency in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'];
    }

    function isValidIncidentStatus(status) {
      return status in [
        'DRAFT',
        'NEW',
        'SUBMITTED',
        'PENDING_REVIEW',
        'UNDER_REVIEW',
        'UNDER_INVESTIGATION',
        'VERIFIED',
        'UNVERIFIED',
        'ESCALATED',
        'RESOLVED',
        'REJECTED',
        'CLOSED'
      ];
    }

    function isValidVerificationStatus(status) {
      return status in [
        'DRAFT',
        'SUBMITTED',
        'PENDING_VERIFICATION',
        'UNDER_REVIEW',
        'VERIFIED',
        'DISCREPANCY_DETECTED',
        'CORRECTED',
        'REJECTED',
        'REQUIRES_CORRECTION'
      ];
    }

    function isValidPartyVotesOptional(data) {
      return (!('apcVotes' in data) || (data.apcVotes is int && data.apcVotes >= 0 && data.apcVotes <= 50000)) &&
        (!('pdpVotes' in data) || (data.pdpVotes is int && data.pdpVotes >= 0 && data.pdpVotes <= 50000)) &&
        (!('adcVotes' in data) || (data.adcVotes is int && data.adcVotes >= 0 && data.adcVotes <= 50000)) &&
        (!('othersVotes' in data) || (data.othersVotes is int && data.othersVotes >= 0 && data.othersVotes <= 50000));
    }

    function hasConsistentVoteMath(data) {
      return data.totalVotesCast == data.validVotes + data.rejectedVotes &&
        (!('apcVotes' in data) || (
          data.apcVotes is int &&
          data.pdpVotes is int &&
          data.adcVotes is int &&
          data.othersVotes is int &&
          data.validVotes == data.apcVotes + data.pdpVotes + data.adcVotes + data.othersVotes
        ));
    }

    // --- VALIDATION HELPERS ---
    function isValidBootstrap(data) {
      return data.keys().hasAll(['initializedByUid', 'initializedByEmail', 'cycleYear', 'constituencyName', 'createdAt']) &&
        data.keys().hasOnly(['initializedByUid', 'initializedByEmail', 'cycleYear', 'constituencyName', 'createdAt']) &&
        data.initializedByUid is string && data.initializedByUid.size() <= 128 &&
        data.initializedByEmail is string && data.initializedByEmail.size() <= 200 &&
        data.cycleYear is int && data.cycleYear >= 2024 && data.cycleYear <= 2040 &&
        data.constituencyName is string && data.constituencyName.size() >= 3 && data.constituencyName.size() <= 120 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidGlobalSettings(data) {
      return data.keys().hasAll(['inactivityTimeoutMinutes', 'mfaPrepared', 'publicSummaryEnabled', 'smsFallbackConfigured', 'whatsappConfigured', 'emailConfigured', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['inactivityTimeoutMinutes', 'offlineSessionMaxDays', 'mfaPrepared', 'publicSummaryEnabled', 'smsFallbackConfigured', 'whatsappConfigured', 'emailConfigured', 'whatsappGroupName', 'whatsappGroupUrl', 'whatsappGroupEnabled', 'updatedByUid', 'updatedAt']) &&
        data.inactivityTimeoutMinutes is int && data.inactivityTimeoutMinutes >= 5 && data.inactivityTimeoutMinutes <= 480 &&
        (!('offlineSessionMaxDays' in data) || (data.offlineSessionMaxDays is int && data.offlineSessionMaxDays >= 1 && data.offlineSessionMaxDays <= 30)) &&
        data.mfaPrepared is bool &&
        data.publicSummaryEnabled is bool &&
        data.smsFallbackConfigured is bool &&
        data.whatsappConfigured is bool &&
        data.emailConfigured is bool &&
        (!('whatsappGroupName' in data) || (data.whatsappGroupName is string && data.whatsappGroupName.size() >= 1 && data.whatsappGroupName.size() <= 120)) &&
        (!('whatsappGroupUrl' in data) || (data.whatsappGroupUrl is string && data.whatsappGroupUrl.size() <= 400 && (data.whatsappGroupUrl == '' || data.whatsappGroupUrl.matches('^https://chat\\.whatsapp\\.com/[A-Za-z0-9_?=&%+\\-/]+$')))) &&
        (!('whatsappGroupEnabled' in data) || data.whatsappGroupEnabled is bool) &&
        data.updatedByUid is string && data.updatedByUid.size() <= 128 &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedByUid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedByUid', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        data.grantedByUid is string && data.grantedByUid.size() <= 128 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'assignedLgaId', 'assignedWardId', 'assignedPollingUnitId', 'sessionRevoked', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'authMethod', 'role', 'status', 'assignedLgaId', 'assignedWardId', 'assignedPollingUnitId', 'requestedLgaId', 'requestedWardId', 'requestedWardName', 'requestedPollingUnitId', 'requestedPollingUnitCode', 'requestedPollingUnitName', 'sessionRevoked', 'revokedReason', 'batteryLevel', 'batteryCharging', 'batteryUpdatedAt', 'lastPasswordChangedAt', 'lastLoginAt', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
        (!('authMethod' in data) || data.authMethod in ['GOOGLE', 'PHONE_PASSWORD', 'EMAIL_PASSWORD']) &&
        isValidRole(data.role) &&
        isValidAccountStatus(data.status) &&
        data.assignedLgaId is string && data.assignedLgaId.size() <= 32 &&
        data.assignedWardId is string && data.assignedWardId.size() <= 128 &&
        data.assignedPollingUnitId is string && data.assignedPollingUnitId.size() <= 128 &&
        (!('requestedLgaId' in data) || data.requestedLgaId == null || (data.requestedLgaId is string && data.requestedLgaId.size() <= 32)) &&
        (!('requestedWardId' in data) || data.requestedWardId == null || (data.requestedWardId is string && data.requestedWardId.size() <= 128)) &&
        (!('requestedWardName' in data) || data.requestedWardName == null || (data.requestedWardName is string && data.requestedWardName.size() <= 120)) &&
        (!('requestedPollingUnitId' in data) || data.requestedPollingUnitId == null || (data.requestedPollingUnitId is string && data.requestedPollingUnitId.size() <= 128)) &&
        (!('requestedPollingUnitCode' in data) || data.requestedPollingUnitCode == null || (data.requestedPollingUnitCode is string && data.requestedPollingUnitCode.size() <= 40)) &&
        (!('requestedPollingUnitName' in data) || data.requestedPollingUnitName == null || (data.requestedPollingUnitName is string && data.requestedPollingUnitName.size() <= 160)) &&
        data.sessionRevoked is bool &&
        (!('revokedReason' in data) || data.revokedReason == null || (data.revokedReason is string && data.revokedReason.size() <= 300)) &&
        (!('batteryLevel' in data) || data.batteryLevel == null || (data.batteryLevel is int && data.batteryLevel >= 0 && data.batteryLevel <= 100)) &&
        (!('batteryCharging' in data) || data.batteryCharging == null || data.batteryCharging is bool) &&
        (!('batteryUpdatedAt' in data) || data.batteryUpdatedAt == null || (data.batteryUpdatedAt is timestamp && data.batteryUpdatedAt <= request.time)) &&
        (!('lastPasswordChangedAt' in data) || data.lastPasswordChangedAt == null || (data.lastPasswordChangedAt is timestamp && data.lastPasswordChangedAt <= request.time)) &&
        (!('lastLoginAt' in data) || data.lastLoginAt == null || (data.lastLoginAt is timestamp && data.lastLoginAt <= request.time)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserCredential(data, uid) {
      return data.keys().hasAll(['uid', 'phoneHash', 'passwordSalt', 'passwordHash', 'passwordAlgorithm', 'recoveryKeySalt', 'recoveryKeyHash', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'phoneHash', 'passwordSalt', 'passwordHash', 'passwordAlgorithm', 'recoveryKeySalt', 'recoveryKeyHash', 'createdAt', 'updatedAt']) &&
        data.uid == uid &&
        data.phoneHash is string && data.phoneHash.size() >= 16 && data.phoneHash.size() <= 128 &&
        data.passwordSalt is string && data.passwordSalt.size() >= 16 && data.passwordSalt.size() <= 128 &&
        data.passwordHash is string && data.passwordHash.size() >= 32 && data.passwordHash.size() <= 256 &&
        data.passwordAlgorithm == 'PBKDF2-SHA256-100K' &&
        data.recoveryKeySalt is string && data.recoveryKeySalt.size() <= 128 &&
        data.recoveryKeyHash is string && data.recoveryKeyHash.size() <= 256 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPhoneIndex(data, phoneHash) {
      return data.keys().hasAll(['phoneHash', 'ownerUidHash', 'authSeq', 'pendingNextAuthSeq', 'resetPinSalt', 'resetPinHash', 'recoveryKeySalt', 'recoveryKeyHash', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['phoneHash', 'ownerUidHash', 'accountType', 'authSeq', 'pendingNextAuthSeq', 'resetPinSalt', 'resetPinHash', 'recoveryKeySalt', 'recoveryKeyHash', 'createdAt', 'updatedAt']) &&
        data.phoneHash == phoneHash &&
        data.ownerUidHash is string && data.ownerUidHash.size() >= 16 && data.ownerUidHash.size() <= 128 &&
        (!('accountType' in data) || data.accountType in ['PHONE_PASSWORD', 'EMAIL_PASSWORD']) &&
        data.authSeq is int && data.authSeq >= 0 && data.authSeq <= 100 &&
        data.pendingNextAuthSeq is int && data.pendingNextAuthSeq >= 0 && data.pendingNextAuthSeq <= 100 &&
        data.resetPinSalt is string && data.resetPinSalt.size() <= 128 &&
        data.resetPinHash is string && data.resetPinHash.size() <= 256 &&
        data.recoveryKeySalt is string && data.recoveryKeySalt.size() <= 128 &&
        data.recoveryKeyHash is string && data.recoveryKeyHash.size() <= 256 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLocationCatalog(data, lgaId) {
      return isValidLgaId(lgaId) &&
        data.keys().hasAll(['lgaId', 'lgaName', 'lgaCode', 'wards', 'pollingUnits', 'wardCount', 'puCount', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['lgaId', 'lgaName', 'lgaCode', 'wards', 'pollingUnits', 'wardCount', 'puCount', 'updatedByUid', 'updatedAt']) &&
        data.lgaId == lgaId &&
        data.lgaName is string && data.lgaName.size() >= 2 && data.lgaName.size() <= 80 &&
        data.lgaCode is string && data.lgaCode.size() >= 2 && data.lgaCode.size() <= 24 &&
        data.wards is list && data.wards.size() <= 50 && (data.wards.size() == 0 || data.wards[0] is map) &&
        data.pollingUnits is list && data.pollingUnits.size() <= 1000 && (data.pollingUnits.size() == 0 || data.pollingUnits[0] is map) &&
        data.wardCount is int && data.wardCount >= 0 && data.wardCount <= 50 &&
        data.puCount is int && data.puCount >= 0 && data.puCount <= 1000 &&
        data.updatedByUid is string && data.updatedByUid.size() <= 128 &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPasswordResetRequest(data) {
      return data.keys().hasAll(['phoneHash', 'maskedPhone', 'applicantName', 'lgaId', 'wardName', 'puCode', 'recoveryKeyMatched', 'status', 'reviewerNote', 'reviewedByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['phoneHash', 'maskedPhone', 'applicantName', 'lgaId', 'wardName', 'puCode', 'recoveryKeyMatched', 'status', 'reviewerNote', 'reviewedByUid', 'createdAt', 'updatedAt']) &&
        data.phoneHash is string && data.phoneHash.size() >= 16 && data.phoneHash.size() <= 128 &&
        data.maskedPhone is string && data.maskedPhone.size() >= 4 && data.maskedPhone.size() <= 32 &&
        data.applicantName is string && data.applicantName.size() >= 2 && data.applicantName.size() <= 120 &&
        data.lgaId is string && data.lgaId.size() <= 32 &&
        data.wardName is string && data.wardName.size() <= 120 &&
        data.puCode is string && data.puCode.size() <= 40 &&
        data.recoveryKeyMatched is bool &&
        data.status in ['PENDING', 'APPROVED', 'COMPLETED', 'REJECTED'] &&
        data.reviewerNote is string && data.reviewerNote.size() <= 400 &&
        data.reviewedByUid is string && data.reviewedByUid.size() <= 128 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserPreferences(data) {
      return data.keys().hasAll(['uid', 'criticalAlertsEnabled', 'resultUpdatesEnabled', 'incidentDigestEnabled', 'soundAlertsEnabled', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'criticalAlertsEnabled', 'resultUpdatesEnabled', 'incidentDigestEnabled', 'soundAlertsEnabled', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.criticalAlertsEnabled is bool &&
        data.resultUpdatesEnabled is bool &&
        data.incidentDigestEnabled is bool &&
        data.soundAlertsEnabled is bool &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPartyConfig(data, partyId) {
      return partyId in ['APC', 'PDP', 'ADC', 'OTHERS'] &&
        data.keys().hasAll(['partyCode', 'partyName', 'logoUrl', 'storageMode', 'updatedByUid', 'updatedByName', 'updatedAt']) &&
        data.keys().hasOnly(['partyCode', 'partyName', 'logoUrl', 'storageMode', 'storagePath', 'logoAssetId', 'fileName', 'contentType', 'fileSizeBytes', 'sha256Hash', 'updatedByUid', 'updatedByName', 'updatedAt']) &&
        data.partyCode == partyId &&
        ((partyId == 'APC' && data.partyName == 'All Progressives Congress') ||
         (partyId == 'PDP' && data.partyName == 'Peoples Democratic Party') ||
         (partyId == 'ADC' && data.partyName == 'African Democratic Congress') ||
         (partyId == 'OTHERS' && data.partyName == 'Other Political Parties')) &&
        data.logoUrl is string && data.logoUrl.size() <= 350000 &&
        !data.logoUrl.matches('^blob:.*') &&
        data.storageMode in ['firebase_storage', 'firestore_asset_store', 'firestore_cloud', 'none'] &&
        (!('storagePath' in data) || data.storagePath == null || (data.storagePath is string && data.storagePath.size() <= 240)) &&
        (!('logoAssetId' in data) || data.logoAssetId == null || (data.logoAssetId is string && data.logoAssetId.size() <= 128 && (data.logoAssetId == '' || isValidId(data.logoAssetId)))) &&
        (!('fileName' in data) || data.fileName == null || (data.fileName is string && data.fileName.size() <= 120)) &&
        (!('contentType' in data) || data.contentType == null || (data.contentType is string && data.contentType in ['', 'image/png', 'image/jpeg', 'image/webp'])) &&
        (!('fileSizeBytes' in data) || data.fileSizeBytes == null || (data.fileSizeBytes is int && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 5242880)) &&
        (!('sha256Hash' in data) || data.sha256Hash == null || (data.sha256Hash is string && data.sha256Hash.size() <= 64)) &&
        data.updatedByUid is string && data.updatedByUid.size() <= 128 &&
        data.updatedByName is string && data.updatedByName.size() <= 120 &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPartyLogoAsset(data, assetId) {
      return isValidId(assetId) &&
        data.keys().hasAll(['assetId', 'partyCode', 'fileName', 'contentType', 'fileSizeBytes', 'width', 'height', 'sha256Hash', 'binaryData', 'uploadedByUid', 'uploadedByName', 'createdAt']) &&
        data.keys().hasOnly(['assetId', 'partyCode', 'fileName', 'contentType', 'fileSizeBytes', 'width', 'height', 'sha256Hash', 'binaryData', 'uploadedByUid', 'uploadedByName', 'createdAt']) &&
        data.assetId == assetId &&
        data.partyCode in ['APC', 'PDP', 'ADC', 'OTHERS'] &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 120 &&
        data.contentType in ['image/png', 'image/jpeg', 'image/webp'] &&
        data.fileSizeBytes is int && data.fileSizeBytes > 0 && data.fileSizeBytes <= 750000 &&
        data.width is int && data.width >= 1 && data.width <= 2048 &&
        data.height is int && data.height >= 1 && data.height <= 2048 &&
        data.sha256Hash is string && data.sha256Hash.size() == 64 &&
        data.binaryData is bytes && data.binaryData.size() > 0 && data.binaryData.size() <= 750000 &&
        data.uploadedByUid is string && data.uploadedByUid == request.auth.uid && data.uploadedByUid.size() <= 128 &&
        data.uploadedByName is string && data.uploadedByName.size() <= 120 &&
        data.createdAt is timestamp && data.createdAt == request.time;
    }

    function isValidWard(data) {
      return data.keys().hasAll(['lgaId', 'wardCode', 'name', 'coordinatorUid', 'coordinatorName', 'expectedPollingUnits', 'isTestData', 'createdByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['lgaId', 'wardCode', 'name', 'coordinatorUid', 'coordinatorName', 'expectedPollingUnits', 'isTestData', 'createdByUid', 'createdAt', 'updatedAt']) &&
        isValidLgaId(data.lgaId) &&
        data.wardCode is string && data.wardCode.size() >= 1 && data.wardCode.size() <= 32 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.coordinatorUid is string && data.coordinatorUid.size() <= 128 &&
        data.coordinatorName is string && data.coordinatorName.size() <= 120 &&
        data.expectedPollingUnits is int && data.expectedPollingUnits >= 0 && data.expectedPollingUnits <= 500 &&
        data.isTestData is bool &&
        data.createdByUid is string && data.createdByUid.size() <= 128 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPollingUnit(data) {
      return data.keys().hasAll(['lgaId', 'wardId', 'wardName', 'puCode', 'name', 'locationDescription', 'coordinatesVerified', 'assignedAgentUid', 'assignedAgentName', 'operationalStatus', 'registeredVoters', 'isTestData', 'createdByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['lgaId', 'wardId', 'wardName', 'puCode', 'name', 'locationDescription', 'latitude', 'longitude', 'coordinatesVerified', 'assignedAgentUid', 'assignedAgentName', 'operationalStatus', 'registeredVoters', 'puStatusLabel', 'isMasterRecord', 'isTestData', 'createdByUid', 'createdAt', 'updatedAt']) &&
        isValidLgaId(data.lgaId) &&
        data.wardId is string && data.wardId.size() >= 1 && data.wardId.size() <= 128 &&
        data.wardName is string && data.wardName.size() >= 1 && data.wardName.size() <= 120 &&
        data.puCode is string && data.puCode.size() >= 2 && data.puCode.size() <= 40 &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 160 &&
        data.locationDescription is string && data.locationDescription.size() <= 300 &&
        (!('latitude' in data) || data.latitude == null || data.latitude is number) &&
        (!('longitude' in data) || data.longitude == null || data.longitude is number) &&
        data.coordinatesVerified is bool &&
