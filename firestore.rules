        data.lgaId is string && data.lgaId.size() <= 32 &&
        data.wardId is string && data.wardId.size() <= 128 &&
        data.puId is string && data.puId.size() <= 128 &&
        data.puCode is string && data.puCode.size() <= 40 &&
        data.actorUid is string && data.actorUid.size() <= 128 &&
        data.actorName is string && data.actorName.size() <= 120 &&
        data.isTestData is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['title', 'body', 'type', 'targetLgaId', 'targetWardId', 'isCritical', 'createdByUid', 'createdAt']) &&
        data.keys().hasOnly(['title', 'body', 'type', 'targetLgaId', 'targetWardId', 'isCritical', 'isTestData', 'createdByUid', 'createdAt']) &&
        data.title is string && data.title.size() <= 160 &&
        data.body is string && data.body.size() <= 1000 &&
        data.type is string && data.type.size() <= 64 &&
        data.targetLgaId is string && data.targetLgaId.size() <= 32 &&
        data.targetWardId is string && data.targetWardId.size() <= 128 &&
        data.isCritical is bool &&
        (!('isTestData' in data) || data.isTestData is bool) &&
        data.createdByUid is string && data.createdByUid.size() <= 128 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidEmergencyContact(data) {
      return data.keys().hasAll(['name', 'roleLabel', 'phoneNumber', 'scopeLgaId', 'isPriority', 'notes', 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'roleLabel', 'phoneNumber', 'scopeLgaId', 'isPriority', 'notes', 'createdByUid', 'updatedByUid', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.roleLabel is string && data.roleLabel.size() <= 100 &&
        data.phoneNumber is string && data.phoneNumber.size() >= 6 && data.phoneNumber.size() <= 24 &&
        data.phoneNumber.matches('^[+0-9][0-9\\s\\-()]{4,22}[0-9]$') &&
        data.scopeLgaId in ['all', 'funtua', 'dandume'] &&
        data.isPriority is bool &&
        data.notes is string && data.notes.size() <= 240 &&
        data.createdByUid is string && data.createdByUid.size() <= 128 &&
        data.updatedByUid is string && data.updatedByUid.size() <= 128 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidOperationalNote(data) {
      return data.keys().hasAll(['clientNoteId', 'title', 'content', 'category', 'lgaId', 'wardId', 'puId', 'puCode', 'puName', 'authorUid', 'authorName', 'isPinned', 'isTestData', 'revision', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['clientNoteId', 'title', 'content', 'category', 'lgaId', 'wardId', 'puId', 'puCode', 'puName', 'authorUid', 'authorName', 'isPinned', 'isTestData', 'revision', 'clientCreatedAtIso', 'serverSyncedAt', 'createdAt', 'updatedAt']) &&
        data.clientNoteId is string && data.clientNoteId.size() >= 1 && data.clientNoteId.size() <= 128 &&
        data.title is string && data.title.size() <= 120 &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 1000 &&
        data.category in ['GENERAL', 'FIELD_UPDATE', 'LOGISTICS', 'HANDOVER', 'URGENT'] &&
        data.lgaId in ['all', 'funtua', 'dandume'] &&
        data.wardId is string && data.wardId.size() <= 128 &&
        data.puId is string && data.puId.size() <= 128 &&
        data.puCode is string && data.puCode.size() <= 40 &&
        data.puName is string && data.puName.size() <= 160 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120 &&
        data.isPinned is bool &&
        data.isTestData is bool &&
        data.revision is int && data.revision >= 1 &&
        (!('clientCreatedAtIso' in data) || data.clientCreatedAtIso == null || (data.clientCreatedAtIso is string && data.clientCreatedAtIso.size() <= 64)) &&
        (!('serverSyncedAt' in data) || data.serverSyncedAt == null || (data.serverSyncedAt is timestamp && data.serverSyncedAt <= request.time)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTaskPriority(priority) {
      return priority in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'];
    }

    function isValidTaskStatus(status) {
      return status in [
        'ASSIGNED',
        'ACKNOWLEDGED',
        'IN_PROGRESS',
        'AWAITING_REVIEW',
        'REVISION_REQUIRED',
        'APPROVED_COMPLETED',
        'OVERDUE'
      ];
    }

    function isValidOperationalTask(data) {
      return data.keys().hasAll([
          'title', 'description', 'priority', 'status', 'lgaId', 'wardId', 'wardName',
          'assignedOfficerUid', 'assignedOfficerName', 'assignedByUid', 'assignedByName',
          'startDateIso', 'dueDateIso', 'progressPercent', 'acknowledgedAtIso',
          'submittedForReviewAtIso', 'completedAtIso', 'latestFieldReport', 'delayReason',
          'adminFeedback', 'updateRequestedAtIso', 'updateRequestNote', 'reviewedByUid',
          'reviewedByName', 'clientSubmissionId', 'isTestData', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'description', 'priority', 'status', 'lgaId', 'wardId', 'wardName',
          'assignedOfficerUid', 'assignedOfficerName', 'assignedByUid', 'assignedByName',
          'startDateIso', 'dueDateIso', 'progressPercent', 'acknowledgedAtIso',
          'submittedForReviewAtIso', 'completedAtIso', 'latestFieldReport', 'delayReason',
          'evidenceBase64', 'evidenceFileName', 'adminFeedback', 'updateRequestedAtIso',
          'updateRequestNote', 'reviewedByUid', 'reviewedByName', 'clientSubmissionId',
          'clientCreatedAtIso', 'serverSyncedAt', 'isTestData', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 160 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 2000 &&
        isValidTaskPriority(data.priority) &&
        isValidTaskStatus(data.status) &&
        isValidLgaId(data.lgaId) &&
        data.wardId is string && data.wardId.size() >= 1 && data.wardId.size() <= 128 &&
        data.wardName is string && data.wardName.size() >= 1 && data.wardName.size() <= 120 &&
        data.assignedOfficerUid is string && data.assignedOfficerUid.size() >= 1 && data.assignedOfficerUid.size() <= 128 &&
        data.assignedOfficerName is string && data.assignedOfficerName.size() >= 1 && data.assignedOfficerName.size() <= 120 &&
        data.assignedByUid is string && data.assignedByUid.size() >= 1 && data.assignedByUid.size() <= 128 &&
        data.assignedByName is string && data.assignedByName.size() >= 1 && data.assignedByName.size() <= 120 &&
        data.startDateIso is string && data.startDateIso.size() >= 8 && data.startDateIso.size() <= 40 &&
        data.dueDateIso is string && data.dueDateIso.size() >= 8 && data.dueDateIso.size() <= 40 &&
        data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100 &&
        data.acknowledgedAtIso is string && data.acknowledgedAtIso.size() <= 64 &&
        data.submittedForReviewAtIso is string && data.submittedForReviewAtIso.size() <= 64 &&
        data.completedAtIso is string && data.completedAtIso.size() <= 64 &&
        data.latestFieldReport is string && data.latestFieldReport.size() <= 2000 &&
        data.delayReason is string && data.delayReason.size() <= 1000 &&
        (!('evidenceBase64' in data) || data.evidenceBase64 == null || (data.evidenceBase64 is string && data.evidenceBase64.size() <= 350000)) &&
        (!('evidenceFileName' in data) || data.evidenceFileName == null || (data.evidenceFileName is string && data.evidenceFileName.size() <= 120)) &&
        data.adminFeedback is string && data.adminFeedback.size() <= 1500 &&
        data.updateRequestedAtIso is string && data.updateRequestedAtIso.size() <= 64 &&
        data.updateRequestNote is string && data.updateRequestNote.size() <= 600 &&
        data.reviewedByUid is string && data.reviewedByUid.size() <= 128 &&
        data.reviewedByName is string && data.reviewedByName.size() <= 120 &&
        data.clientSubmissionId is string && data.clientSubmissionId.size() >= 1 && data.clientSubmissionId.size() <= 128 &&
        (!('clientCreatedAtIso' in data) || data.clientCreatedAtIso == null || (data.clientCreatedAtIso is string && data.clientCreatedAtIso.size() <= 64)) &&
        (!('serverSyncedAt' in data) || data.serverSyncedAt == null || (data.serverSyncedAt is timestamp && data.serverSyncedAt <= request.time)) &&
        data.isTestData is bool &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTaskUpdateEntry(data, taskId) {
      return data.keys().hasAll([
          'taskId', 'entryType', 'statusSnapshot', 'progressPercent', 'summary',
          'delayReason', 'actorUid', 'actorName', 'actorRole', 'clientSubmissionId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'taskId', 'entryType', 'statusSnapshot', 'progressPercent', 'summary',
          'delayReason', 'evidenceBase64', 'evidenceFileName', 'actorUid', 'actorName',
          'actorRole', 'clientSubmissionId', 'clientCreatedAtIso', 'serverSyncedAt', 'createdAt'
        ]) &&
        data.taskId == taskId &&
        data.entryType in ['OFFICER_PROGRESS', 'FIELD_REPORT', 'UPDATE_REQUEST', 'ADMIN_REVIEW', 'STATUS_CHANGE'] &&
        isValidTaskStatus(data.statusSnapshot) &&
        data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 2000 &&
        data.delayReason is string && data.delayReason.size() <= 1000 &&
        (!('evidenceBase64' in data) || data.evidenceBase64 == null || (data.evidenceBase64 is string && data.evidenceBase64.size() <= 350000)) &&
        (!('evidenceFileName' in data) || data.evidenceFileName == null || (data.evidenceFileName is string && data.evidenceFileName.size() <= 120)) &&
        data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
        data.actorRole is string && data.actorRole.size() <= 40 &&
        data.clientSubmissionId is string && data.clientSubmissionId.size() >= 1 && data.clientSubmissionId.size() <= 128 &&
        (!('clientCreatedAtIso' in data) || data.clientCreatedAtIso == null || (data.clientCreatedAtIso is string && data.clientCreatedAtIso.size() <= 64)) &&
        (!('serverSyncedAt' in data) || data.serverSyncedAt == null || (data.serverSyncedAt is timestamp && data.serverSyncedAt <= request.time)) &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidGeneratedReport(data) {
      return data.keys().hasAll([
          'reportCategory', 'reportTitle', 'reportingPeriodStartIso', 'reportingPeriodEndIso',
          'lgaId', 'wardId', 'puId', 'officerUid', 'scopeLabel', 'generatedByUid',
          'generatedByName', 'generationMode', 'dataStatus', 'dataCompletenessNotice',
          'rowCount', 'headers', 'summaryMetrics', 'clientSubmissionId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'reportCategory', 'reportTitle', 'reportingPeriodStartIso', 'reportingPeriodEndIso',
          'lgaId', 'wardId', 'puId', 'officerUid', 'scopeLabel', 'generatedByUid',
          'generatedByName', 'generationMode', 'dataStatus', 'dataCompletenessNotice',
          'rowCount', 'headers', 'summaryMetrics', 'clientSubmissionId', 'clientCreatedAtIso',
          'serverSyncedAt', 'createdAt'
        ]) &&
        data.reportCategory in [
          'DAILY_SITUATION',
          'WARD_PERFORMANCE',
          'LGA_SUMMARY',
          'PU_COVERAGE',
          'ELECTION_INCIDENT',
          'AGENT_ACTIVITY',
          'OFFICER_PERFORMANCE',
          'TASK_COMPLETION',
          'FIELD_CHECKIN',
          'RESULTS_SUBMISSION_STATUS',
          'DATA_SYNCHRONIZATION',
          'OUTSTANDING_ACTIONS'
        ] &&
        data.reportTitle is string && data.reportTitle.size() >= 3 && data.reportTitle.size() <= 180 &&
        data.reportingPeriodStartIso is string && data.reportingPeriodStartIso.size() <= 40 &&
        data.reportingPeriodEndIso is string && data.reportingPeriodEndIso.size() <= 40 &&
        data.lgaId in ['all', 'funtua', 'dandume'] &&
        data.wardId is string && data.wardId.size() <= 128 &&
        data.puId is string && data.puId.size() <= 128 &&
        data.officerUid is string && data.officerUid.size() <= 128 &&
        data.scopeLabel is string && data.scopeLabel.size() <= 160 &&
        data.generatedByUid is string && data.generatedByUid.size() >= 1 && data.generatedByUid.size() <= 128 &&
        data.generatedByName is string && data.generatedByName.size() >= 1 && data.generatedByName.size() <= 120 &&
        data.generationMode in ['AUTOMATIC_DAILY', 'ON_DEMAND'] &&
        data.dataStatus is string && data.dataStatus.size() <= 160 &&
        data.dataCompletenessNotice is string && data.dataCompletenessNotice.size() <= 600 &&
        data.rowCount is int && data.rowCount >= 0 && data.rowCount <= 5000 &&
        data.headers is list && data.headers.size() <= 40 && (data.headers.size() == 0 || data.headers[0] is string) &&
        data.summaryMetrics is map &&
        data.clientSubmissionId is string && data.clientSubmissionId.size() >= 1 && data.clientSubmissionId.size() <= 128 &&
        (!('clientCreatedAtIso' in data) || data.clientCreatedAtIso == null || (data.clientCreatedAtIso is string && data.clientCreatedAtIso.size() <= 64)) &&
        (!('serverSyncedAt' in data) || data.serverSyncedAt == null || (data.serverSyncedAt is timestamp && data.serverSyncedAt <= request.time)) &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidDeletionTombstone(data) {
      return data.keys().hasAll(['recordId', 'collectionName', 'deletedByUid', 'deletedByEmail', 'reason', 'deletedAtIso', 'createdAt']) &&
        data.keys().hasOnly(['recordId', 'collectionName', 'deletedByUid', 'deletedByEmail', 'reason', 'deletedAtIso', 'createdAt']) &&
        data.recordId is string && data.recordId.size() >= 1 && data.recordId.size() <= 128 &&
        data.collectionName is string && data.collectionName.size() >= 1 && data.collectionName.size() <= 64 &&
        data.deletedByUid is string && data.deletedByUid.size() >= 1 && data.deletedByUid.size() <= 128 &&
        data.deletedByEmail is string && data.deletedByEmail.size() <= 200 &&
        data.reason is string && data.reason.size() <= 240 &&
        data.deletedAtIso is string && data.deletedAtIso.size() <= 64 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSystemBackup(data) {
      return data.keys().hasAll(['backupType', 'label', 'encryptionAlgorithm', 'sha256Checksum', 'sizeBytes', 'recordCounts', 'status', 'createdByUid', 'createdByName', 'createdAtIso', 'createdAt']) &&
        data.keys().hasOnly(['backupType', 'label', 'encryptionAlgorithm', 'sha256Checksum', 'sizeBytes', 'recordCounts', 'status', 'errorMessage', 'createdByUid', 'createdByName', 'createdAtIso', 'createdAt']) &&
        data.backupType in ['SCHEDULED_AUTO', 'MANUAL_ADMIN', 'PRE_RESTORATION'] &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 140 &&
        data.encryptionAlgorithm == 'AES-GCM-256' &&
        data.sha256Checksum is string && data.sha256Checksum.size() == 64 &&
        data.sizeBytes is int && data.sizeBytes >= 0 &&
        data.recordCounts is map &&
        data.status in ['COMPLETED', 'VERIFIED', 'FAILED'] &&
        (!('errorMessage' in data) || data.errorMessage == null || (data.errorMessage is string && data.errorMessage.size() <= 400)) &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        data.createdByName is string && data.createdByName.size() >= 1 && data.createdByName.size() <= 120 &&
        data.createdAtIso is string && data.createdAtIso.size() <= 64 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidEscalationRule(data) {
      return data.keys().hasAll(['ruleName', 'triggerType', 'priority', 'responsibleRole', 'escalateAfterMinutes', 'recipientRole', 'maxNotificationsPerHour', 'enabled', 'updatedByUid', 'updatedAt']) &&
        data.keys().hasOnly(['ruleName', 'triggerType', 'priority', 'responsibleRole', 'escalateAfterMinutes', 'recipientRole', 'maxNotificationsPerHour', 'enabled', 'updatedByUid', 'updatedAt']) &&
        data.ruleName is string && data.ruleName.size() >= 2 && data.ruleName.size() <= 120 &&
        data.triggerType in ['MISSING_CHECKIN', 'CRITICAL_INCIDENT', 'OVERDUE_TASK', 'RESULT_DISCREPANCY', 'SYNC_FAILURE', 'LOW_WARD_COVERAGE', 'EMERGENCY_ASSISTANCE'] &&
        isValidUrgency(data.priority) &&
        isValidRole(data.responsibleRole) &&
        data.escalateAfterMinutes is int && data.escalateAfterMinutes >= 5 && data.escalateAfterMinutes <= 1440 &&
        isValidRole(data.recipientRole) &&
        data.maxNotificationsPerHour is int && data.maxNotificationsPerHour >= 1 && data.maxNotificationsPerHour <= 60 &&
        data.enabled is bool &&
        data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidEmergencyReport(data) {
      return data.keys().hasAll(['category', 'description', 'urgency', 'status', 'lgaId', 'wardId', 'puId', 'puCode', 'puName', 'reporterUid', 'reporterName', 'reporterPhone', 'assignedResponderUid', 'assignedResponderName', 'resolutionNotes', 'clientSubmissionId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['category', 'description', 'urgency', 'status', 'lgaId', 'wardId', 'puId', 'puCode', 'puName', 'latitude', 'longitude', 'reporterUid', 'reporterName', 'reporterPhone', 'assignedResponderUid', 'assignedResponderName', 'resolutionNotes', 'clientSubmissionId', 'clientCreatedAtIso', 'createdAt', 'updatedAt']) &&
        data.category is string && data.category.size() >= 2 && data.category.size() <= 100 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 1200 &&
        isValidUrgency(data.urgency) &&
        data.status in ['SUBMITTED', 'ACKNOWLEDGED', 'RESPONDER_ASSIGNED', 'RESOLVED', 'CLOSED'] &&
        data.lgaId in ['all', 'funtua', 'dandume'] &&
        data.wardId is string && data.wardId.size() <= 128 &&
        data.puId is string && data.puId.size() <= 128 &&
        data.puCode is string && data.puCode.size() <= 40 &&
        data.puName is string && data.puName.size() <= 160 &&
        (!('latitude' in data) || data.latitude == null || data.latitude is number) &&
        (!('longitude' in data) || data.longitude == null || data.longitude is number) &&
        data.reporterUid is string && data.reporterUid.size() >= 1 && data.reporterUid.size() <= 128 &&
        data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 120 &&
        data.reporterPhone is string && data.reporterPhone.size() <= 30 &&
        data.assignedResponderUid is string && data.assignedResponderUid.size() <= 128 &&
        data.assignedResponderName is string && data.assignedResponderName.size() <= 120 &&
        data.resolutionNotes is string && data.resolutionNotes.size() <= 1200 &&
        data.clientSubmissionId is string && data.clientSubmissionId.size() >= 1 && data.clientSubmissionId.size() <= 128 &&
        (!('clientCreatedAtIso' in data) || data.clientCreatedAtIso == null || (data.clientCreatedAtIso is string && data.clientCreatedAtIso.size() <= 64)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorName', 'actorEmail', 'actorRole', 'action', 'affectedEntity', 'affectedId', 'details', 'createdAt']) &&
        data.keys().hasOnly(['actorUid', 'actorName', 'actorEmail', 'actorRole', 'action', 'affectedEntity', 'affectedId', 'details', 'createdAt']) &&
        data.actorUid is string && data.actorUid.size() <= 128 &&
        data.actorName is string && data.actorName.size() <= 120 &&
        data.actorEmail is string && data.actorEmail.size() <= 200 &&
        data.actorRole is string && data.actorRole.size() <= 40 &&
        data.action is string && data.action.size() <= 100 &&
        data.affectedEntity is string && data.affectedEntity.size() <= 64 &&
        data.affectedId is string && data.affectedId.size() <= 128 &&
        data.details is string && data.details.size() <= 1000 &&
        data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- 1. SYSTEM SETTINGS ---
    match /system_settings/{settingId} {
      allow get: if isVerifiedUser() && isValidId(settingId);
      allow create: if isVerifiedUser() && isValidId(settingId) && (
        (settingId == 'bootstrap' &&
          isVerifiedGoogleUser() &&
          !exists(/databases/$(database)/documents/system_settings/bootstrap) &&
          incoming().initializedByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          isValidBootstrap(incoming())) ||
        (settingId == 'global' &&
          (isFullControlAdmin() || (isVerifiedGoogleUser() && !exists(/databases/$(database)/documents/system_settings/bootstrap))) &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          isValidGlobalSettings(incoming()))
      );
      allow update: if isFullControlAdmin() &&
        settingId == 'global' &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isValidGlobalSettings(incoming());
      allow delete: if false;
    }

    // --- 2. ADMINS REGISTRY ---
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isFullControlAdmin());
      allow list: if isFullControlAdmin();
      allow create: if isVerifiedGoogleUser() && isValidId(uid) &&
        isValidAdminDoc(incoming()) &&
        incoming().uid == uid &&
        incoming().createdAt == request.time && (
          isFullControlAdmin() ||
          (request.auth.uid == uid && !exists(/databases/$(database)/documents/system_settings/bootstrap))
        );
      allow update: if false;
      allow delete: if isFullControlAdmin() && isValidId(uid) && uid != request.auth.uid;
    }

    // --- 3. USERS & RBAC PROFILES ---
    match /users/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (
        request.auth.uid == uid ||
        isFullControlAdmin() ||
        isLgaAdminFor(existing().assignedLgaId) ||
        (existing().status == 'PENDING_APPROVAL' && 'requestedLgaId' in existing() && isLgaAdminFor(existing().requestedLgaId)) ||
        isWardCoordFor(existing().assignedWardId) ||
        isOpsOfficerFor(existing().assignedWardId)
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        isLgaAdminFor(existing().assignedLgaId) ||
        (existing().status == 'PENDING_APPROVAL' && 'requestedLgaId' in existing() && isLgaAdminFor(existing().requestedLgaId)) ||
        isWardCoordFor(existing().assignedWardId) ||
        isOpsOfficerFor(existing().assignedWardId)
      );
      allow create: if isVerifiedUser() && isValidId(uid) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          (request.auth.uid == uid &&
            incoming().role == 'ORDINARY_USER' &&
            incoming().status == 'ACTIVE' &&
            incoming().sessionRevoked == false &&
            isValidLgaId(incoming().assignedLgaId) &&
            incoming().assignedWardId.size() >= 1 &&
            incoming().assignedPollingUnitId.size() >= 1) ||
          (request.auth.uid == uid &&
            incoming().role == 'PENDING' &&
            incoming().status == 'PENDING_APPROVAL' &&
            incoming().sessionRevoked == false &&
            incoming().assignedLgaId == '' &&
            incoming().assignedWardId == '' &&
            incoming().assignedPollingUnitId == '') ||
          (isVerifiedGoogleUser() &&
            request.auth.uid == uid &&
            incoming().role == 'FULL_CONTROL_ADMIN' &&
            incoming().status == 'ACTIVE' &&
            incoming().sessionRevoked == false &&
            (isBootstrappedEmail() || !exists(/databases/$(database)/documents/system_settings/bootstrap))) ||
          isFullControlAdmin()
        );
      allow update: if isVerifiedUser() && isValidId(uid) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (uid != request.auth.uid || incoming().role == existing().role) && (
          isFullControlAdmin() ||
          ((isLgaAdminFor(existing().assignedLgaId) || (existing().status == 'PENDING_APPROVAL' && 'requestedLgaId' in existing() && isLgaAdminFor(existing().requestedLgaId))) &&
            isLgaAdminFor(incoming().assignedLgaId) &&
            existing().role != 'FULL_CONTROL_ADMIN' &&
            incoming().role in ['VERIFICATION_OFFICER', 'OPERATIONS_OFFICER', 'WARD_COORDINATOR', 'POLLING_UNIT_AGENT', 'ORDINARY_USER', 'PENDING'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'assignedLgaId', 'assignedWardId', 'assignedPollingUnitId', 'sessionRevoked', 'revokedReason', 'updatedAt'])) ||
          (isWardCoordFor(existing().assignedWardId) &&
            existing().role == 'POLLING_UNIT_AGENT' &&
            incoming().role == 'POLLING_UNIT_AGENT' &&
            incoming().assignedLgaId == existing().assignedLgaId &&
            incoming().assignedWardId == existing().assignedWardId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['assignedPollingUnitId', 'updatedAt'])) ||
          (request.auth.uid == uid &&
            existing().status == 'ACTIVE' &&
            existing().sessionRevoked != true &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'batteryLevel', 'batteryCharging', 'batteryUpdatedAt', 'lastPasswordChangedAt', 'lastLoginAt', 'updatedAt']))
        );
      allow delete: if isFullControlAdmin() && isValidId(uid) && uid != request.auth.uid;
    }

    // --- 3A. PRIVATE SALTED CREDENTIALS & RECOVERY HASHES ---
    match /user_credentials/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isFullControlAdmin());
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(uid) &&
        (request.auth.uid == uid || isFullControlAdmin()) &&
        isValidUserCredential(incoming(), uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(uid) &&
        isValidUserCredential(incoming(), uid) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (request.auth.uid == uid || isFullControlAdmin());
      allow delete: if isFullControlAdmin() && isValidId(uid) && uid != request.auth.uid;
    }

    // --- 3A2. ZERO-PII PHONE UNIQUENESS INDEX & RECOVERY SLOTS ---
    match /phone_index/{phoneHash} {
      allow get: if isValidId(phoneHash);
      allow list: if false;
      allow create: if isVerifiedUser() && isValidId(phoneHash) &&
        !exists(/databases/$(database)/documents/phone_index/$(phoneHash)) &&
        isValidPhoneIndex(incoming(), phoneHash) &&
        incoming().authSeq == 0 &&
        incoming().pendingNextAuthSeq == 0 &&
        incoming().resetPinSalt == '' &&
        incoming().resetPinHash == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(phoneHash) &&
        isValidPhoneIndex(incoming(), phoneHash) &&
        incoming().phoneHash == existing().phoneHash &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          isLgaAdminFor('funtua') ||
          isLgaAdminFor('dandume') ||
          incoming().ownerUidHash == existing().ownerUidHash ||
          (isPhonePasswordUser() &&
            existing().pendingNextAuthSeq > existing().authSeq &&
            existing().resetPinHash.size() > 0 &&
            incoming().authSeq == existing().pendingNextAuthSeq &&
            incoming().resetPinSalt == '' &&
            incoming().resetPinHash == '')
        );
      allow delete: if isFullControlAdmin() && isValidId(phoneHash);
    }

    // --- 3A3. PUBLIC ZERO-PII LOCATION CATALOG (SYNCED FOR SIGN-UP & APK) ---
    match /location_catalog/{lgaId} {
      allow get: if isValidId(lgaId) && isValidLgaId(lgaId);
      allow list: if isValidLgaId(existing().lgaId);
      allow create, update: if isVerifiedUser() && isValidId(lgaId) &&
        isValidLgaId(lgaId) &&
        isValidLocationCatalog(incoming(), lgaId) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          isLgaAdminFor(lgaId)
        );
      allow delete: if false;
    }

    // --- 3A4. PASSWORD RECOVERY REQUEST QUEUE ---
    match /password_reset_requests/{requestId} {
      allow get, list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        isLgaAdminFor(existing().lgaId)
      );
      allow create: if isValidId(requestId) &&
        !exists(/databases/$(database)/documents/password_reset_requests/$(requestId)) &&
        isValidPasswordResetRequest(incoming()) &&
        incoming().status == 'PENDING' &&
        incoming().reviewedByUid == '' &&
        incoming().reviewerNote == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(requestId) &&
        isValidPasswordResetRequest(incoming()) &&
        incoming().phoneHash == existing().phoneHash &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          isLgaAdminFor(existing().lgaId) ||
          (isPhonePasswordUser() &&
            existing().status == 'APPROVED' &&
            incoming().status == 'COMPLETED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isFullControlAdmin() && isValidId(requestId);
    }

    // --- 3B. USER NOTIFICATION & ACCOUNT PREFERENCES ---
    match /user_preferences/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && request.auth.uid == uid;
      allow create, update: if isVerifiedUser() && isValidId(uid) &&
        request.auth.uid == uid &&
        isValidUserPreferences(incoming()) &&
        incoming().uid == uid &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- 3C. FIXED 4 POLITICAL PARTIES (APC, PDP, ADC, OTHERS) ---
    match /party_configs/{partyId} {
      allow get: if isValidId(partyId) && (isFullControlAdmin() || hasActiveUser());
      allow list: if isFullControlAdmin() || hasActiveUser();
      allow create, update: if isFullControlAdmin() &&
        isValidPartyConfig(incoming(), partyId) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- 3D. PERSISTENT PARTY LOGO BINARY ASSET STORE ---
    match /party_logo_assets/{assetId} {
      allow get: if isValidId(assetId) && (isFullControlAdmin() || hasActiveUser());
      allow list: if isFullControlAdmin();
      allow create: if isFullControlAdmin() &&
        isValidId(assetId) &&
        isValidPartyLogoAsset(incoming(), assetId);
      allow update: if false;
      allow delete: if isFullControlAdmin() && isValidId(assetId);
    }

    // --- 4. WARDS (Controlled Master Dataset) ---
    match /wards/{wardId} {
      allow get: if isVerifiedUser() && isValidId(wardId) && (
        isFullControlAdmin() ||
        (hasActiveUser() && (
          callerDoc().assignedLgaId == existing().lgaId ||
          callerDoc().assignedWardId == wardId ||
          (callerDoc().role == 'VERIFICATION_OFFICER' && callerDoc().assignedLgaId == '')
        ))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        (hasActiveUser() && (
          callerDoc().assignedLgaId == existing().lgaId ||
          (callerDoc().role == 'VERIFICATION_OFFICER' && callerDoc().assignedLgaId == '')
        ))
      );
      allow create: if isFullControlAdmin() && isValidId(wardId) &&
        isValidWard(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isFullControlAdmin() && isValidId(wardId) &&
        isValidWard(incoming()) &&
        incoming().lgaId == existing().lgaId &&
        incoming().wardCode == existing().wardCode &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- 5. POLLING UNITS (Controlled Master Dataset) ---
    match /polling_units/{puId} {
      allow get: if isVerifiedUser() && isValidId(puId) && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, puId, existing().assignedAgentUid) ||
        (hasActiveUser() && callerDoc().role == 'ORDINARY_USER' && callerDoc().assignedPollingUnitId == puId)
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, existing().assignedAgentUid, existing().assignedAgentUid)
      );
      allow create: if isFullControlAdmin() && isValidId(puId) &&
        isValidPollingUnit(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/wards/$(incoming().wardId));
      allow update: if isVerifiedUser() && isValidId(puId) &&
        isValidPollingUnit(incoming()) &&
        incoming().lgaId == existing().lgaId &&
        incoming().wardId == existing().wardId &&
        incoming().puCode == existing().puCode &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          (isLgaAdminFor(existing().lgaId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['assignedAgentUid', 'assignedAgentName', 'operationalStatus', 'registeredVoters', 'updatedAt'])) ||
          (isVerificationOfficerFor(existing().lgaId, existing().wardId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['operationalStatus', 'updatedAt'])) ||
          (isOpsOfficerFor(existing().wardId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['operationalStatus', 'updatedAt'])) ||
          (isWardCoordFor(existing().wardId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['assignedAgentUid', 'assignedAgentName', 'operationalStatus', 'updatedAt'])) ||
          ((isPuAgentFor(puId) || (hasActiveUser() && existing().assignedAgentUid == request.auth.uid)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['operationalStatus', 'registeredVoters', 'updatedAt']))
        );
      allow delete: if false;
    }

    // --- 5A. ATOMIC UNIQUE POLLING UNIT ASSIGNMENTS ---
    match /pu_assignments/{puId} {
      allow get, list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, puId, existing().agentUid)
      );
      allow create: if isVerifiedUser() && isValidId(puId) &&
        !exists(/databases/$(database)/documents/pu_assignments/$(puId)) &&
        isValidPuAssignment(incoming(), puId) &&
        incoming().assignedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          isLgaAdminFor(incoming().lgaId) ||
          isWardCoordFor(incoming().wardId)
        );
      allow update: if isFullControlAdmin() && isValidId(puId) &&
        isValidPuAssignment(incoming(), puId) &&
        incoming().lgaId == existing().lgaId &&
        incoming().wardId == existing().wardId &&
        incoming().createdAt == existing().createdAt &&
        incoming().assignedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if isVerifiedUser() && isValidId(puId) && (
        isFullControlAdmin() ||
        isLgaAdminFor(existing().lgaId) ||
        isWardCoordFor(existing().wardId)
      );
    }

    // --- 5B. MASTER DIRECTORY BACKUPS ---
    match /directory_backups/{backupId} {
      allow get, list: if isFullControlAdmin();
      allow create: if isFullControlAdmin() && isValidId(backupId) &&
        isValidDirectoryBackup(incoming()) &&
        incoming().backedUpByUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // --- 6. AGENT CHECK-INS ---
    match /check_ins/{checkInId} {
      allow get: if isVerifiedUser() && isValidId(checkInId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().agentUid))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().agentUid)
      );
      allow create: if isVerifiedUser() && isValidId(checkInId) &&
        isValidCheckIn(incoming()) &&
        incoming().agentUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/polling_units/$(incoming().puId)) && (
          isFullControlAdmin() ||
          canReadInArea(incoming().lgaId, incoming().wardId, incoming().puId, incoming().agentUid)
        );
      allow update: if isVerifiedUser() && isValidId(checkInId) &&
        isValidCheckIn(incoming()) &&
        incoming().agentUid == existing().agentUid &&
        incoming().puId == existing().puId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['exceptionReviewStatus', 'exceptionReviewNote', 'exceptionReviewedByUid']) &&
        incoming().exceptionReviewedByUid == request.auth.uid && (
          isFullControlAdmin() ||
          isLgaAdminFor(existing().lgaId) ||
          isWardCoordFor(existing().wardId) ||
          isOpsOfficerFor(existing().wardId)
        );
      allow delete: if isFullControlAdmin() && isValidId(checkInId);
    }

    // --- 7. INCIDENTS & ALERTS ---
    match /incidents/{incidentId} {
      allow get: if isVerifiedUser() && isValidId(incidentId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().reporterUid))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().reporterUid)
      );
      allow create: if isVerifiedUser() && isValidId(incidentId) &&
        isValidIncident(incoming()) &&
        incoming().reporterUid == request.auth.uid &&
        incoming().status in ['NEW', 'SUBMITTED'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          canReadInArea(incoming().lgaId, incoming().wardId, incoming().puId, incoming().reporterUid)
        );
      allow update: if isVerifiedUser() && isValidId(incidentId) &&
        isValidIncident(incoming()) &&
        incoming().reporterUid == existing().reporterUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          (isLgaAdminFor(existing().lgaId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'urgency', 'internalNotes', 'escalatedTo', 'requestedInfoNote', 'reviewedByUid', 'updatedAt'])) ||
          ((isWardCoordFor(existing().wardId) || isOpsOfficerFor(existing().wardId)) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'urgency', 'internalNotes', 'escalatedTo', 'requestedInfoNote', 'reviewedByUid', 'updatedAt']))
        );
      allow delete: if isFullControlAdmin() && isValidId(incidentId);

      match /history/{historyId} {
        allow get, list: if isVerifiedUser() && isValidId(incidentId) && (
          isFullControlAdmin() ||
          canReadInArea(
            get(/databases/$(database)/documents/incidents/$(incidentId)).data.lgaId,
            get(/databases/$(database)/documents/incidents/$(incidentId)).data.wardId,
            get(/databases/$(database)/documents/incidents/$(incidentId)).data.puId,
            get(/databases/$(database)/documents/incidents/$(incidentId)).data.reporterUid
          )
        );
        allow create: if isVerifiedUser() && isValidId(incidentId) && isValidId(historyId) &&
          isValidIncidentHistory(incoming()) &&
          incoming().actorUid == request.auth.uid &&
          incoming().createdAt == request.time && (
            isFullControlAdmin() || hasActiveUser()
          );
        allow update: if false;
        allow delete: if isFullControlAdmin() && isValidId(incidentId) && isValidId(historyId);
      }
    }

    // --- 8. RESULT SUBMISSIONS & IMMUTABLE HISTORY ---
    match /result_submissions/{resultId} {
      allow get: if isVerifiedUser() && isValidId(resultId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().submittedByUid))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().submittedByUid)
      );
      allow create: if isVerifiedUser() && isValidId(resultId) &&
        isValidResultSubmission(incoming()) &&
        incoming().submittedByUid == request.auth.uid &&
        incoming().publiclyApproved == false &&
        incoming().verificationStatus in ['DRAFT', 'SUBMITTED', 'DISCREPANCY_DETECTED'] &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/polling_units/$(incoming().puId)) && (
          isFullControlAdmin() ||
          isLgaAdminFor(incoming().lgaId) ||
          isWardCoordFor(incoming().wardId) ||
          isPuAgentFor(incoming().puId) ||
          (hasActiveUser() && get(/databases/$(database)/documents/polling_units/$(incoming().puId)).data.assignedAgentUid == request.auth.uid)
        );
      allow update: if isVerifiedUser() && isValidId(resultId) &&
        isValidResultSubmission(incoming()) &&
        incoming().submittedByUid == existing().submittedByUid &&
        incoming().puId == existing().puId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (incoming().verificationStatus != 'VERIFIED' || existing().submittedByUid != request.auth.uid) && (
          isFullControlAdmin() ||
          ((isLgaAdminFor(existing().lgaId) || isVerificationOfficerFor(existing().lgaId, existing().wardId)) &&
            existing().verificationStatus in ['SUBMITTED', 'PENDING_VERIFICATION', 'UNDER_REVIEW', 'REQUIRES_CORRECTION', 'DISCREPANCY_DETECTED'] &&
            incoming().verificationStatus in ['UNDER_REVIEW', 'VERIFIED', 'REJECTED', 'REQUIRES_CORRECTION', 'DISCREPANCY_DETECTED', 'CORRECTED'] &&
            (!(incoming().verificationStatus in ['REJECTED', 'REQUIRES_CORRECTION', 'DISCREPANCY_DETECTED']) || incoming().reviewNote.size() >= 3) &&
            incoming().publiclyApproved == existing().publiclyApproved &&
            incoming().diff(existing()).affectedKeys().hasOnly(['verificationStatus', 'reviewNote', 'reviewedByUid', 'reviewedByName', 'reviewedAt', 'updatedAt'])) ||
          (hasActiveUser() &&
            existing().submittedByUid == request.auth.uid &&
            existing().verificationStatus in ['DRAFT', 'REQUIRES_CORRECTION', 'DISCREPANCY_DETECTED'] &&
            incoming().verificationStatus in ['DRAFT', 'SUBMITTED', 'DISCREPANCY_DETECTED'] &&
            incoming().publiclyApproved == false &&
            incoming().version >= existing().version &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'electionCategory', 'apcVotes', 'pdpVotes', 'adcVotes', 'othersVotes',
              'registeredVoters', 'accreditedVoters', 'validVotes', 'rejectedVotes', 'totalVotesCast',
              'bvasStatus', 'bvasNotes', 'submissionNotes', 'ec8aImageBase64', 'ec8aFileName',
              'discrepancyFlag', 'discrepancySummary', 'duplicateOfSubmissionId', 'ocrAssistedReviewNote',
              'verificationStatus', 'version', 'updatedAt'
            ]))
        );
      allow delete: if isFullControlAdmin() && isValidId(resultId);

      match /history/{historyId} {
        allow get, list: if isVerifiedUser() && isValidId(resultId) && (
          isFullControlAdmin() ||
          canReadInArea(
            get(/databases/$(database)/documents/result_submissions/$(resultId)).data.lgaId,
            get(/databases/$(database)/documents/result_submissions/$(resultId)).data.wardId,
            get(/databases/$(database)/documents/result_submissions/$(resultId)).data.puId,
            get(/databases/$(database)/documents/result_submissions/$(resultId)).data.submittedByUid
          )
        );
        allow create: if isVerifiedUser() && isValidId(resultId) && isValidId(historyId) &&
          isValidResultHistory(incoming()) &&
          incoming().actorUid == request.auth.uid &&
          incoming().createdAt == request.time && (
            isFullControlAdmin() || hasActiveUser()
          );
        allow update: if false;
        allow delete: if isFullControlAdmin() && isValidId(resultId) && isValidId(historyId);
      }
    }

    // --- 8B. CANONICAL APPROVED PU RESULTS (1 DOC PER PU) ---
    match /approved_pu_results/{puId} {
      allow get: if isVerifiedUser() && isValidId(puId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && canReadInArea(existing().lgaId, existing().wardId, puId, existing().submittedByUid))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().submittedByUid)
      );
      allow create, update: if isVerifiedUser() && isValidId(puId) &&
        isValidApprovedPuResult(incoming(), puId) &&
        incoming().approvedByUid == request.auth.uid &&
        incoming().submittedByUid != request.auth.uid &&
        incoming().approvedAt <= request.time &&
        incoming().updatedAt == request.time &&
        canVerifyScope(incoming().lgaId, incoming().wardId);
      allow delete: if isVerifiedUser() && isValidId(puId) &&
        isFullControlAdmin();
    }

    // --- 8C. TRANSACTIONALLY AGGREGATED WARD / LGA / CONSTITUENCY TOTALS ---
    match /aggregated_results/{aggId} {
      allow get: if isVerifiedUser() && isValidId(aggId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && (
          (existing().scopeType == 'WARD' && canReadInArea(existing().lgaId, existing().wardId, '', '')) ||
          (existing().scopeType == 'LGA' && (isLgaAdminFor(existing().lgaId) || (hasActiveUser() && callerDoc().role == 'VERIFICATION_OFFICER' && (callerDoc().assignedLgaId == '' || callerDoc().assignedLgaId == existing().lgaId)))) ||
          (existing().scopeType == 'CONSTITUENCY' && hasActiveUser() && callerDoc().role in ['FUNTUA_SUPER_ADMIN', 'DANDUME_SUPER_ADMIN', 'VERIFICATION_OFFICER'])
        ))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        (existing().scopeType == 'WARD' && canReadInArea(existing().lgaId, existing().wardId, '', '')) ||
        (existing().scopeType == 'LGA' && (isLgaAdminFor(existing().lgaId) || isVerificationOfficerFor(existing().lgaId, ''))) ||
        (existing().scopeType == 'CONSTITUENCY' && hasActiveUser() && callerDoc().role == 'VERIFICATION_OFFICER' && callerDoc().assignedLgaId == '')
      );
      allow create, update: if isVerifiedUser() && isValidId(aggId) &&
        isValidAggregatedResult(incoming(), aggId) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          (incoming().scopeType == 'WARD' && canVerifyScope(incoming().lgaId, incoming().wardId)) ||
          (incoming().scopeType == 'LGA' && (isLgaAdminFor(incoming().lgaId) || (hasActiveUser() && callerDoc().role == 'VERIFICATION_OFFICER' && (callerDoc().assignedLgaId == '' || callerDoc().assignedLgaId == incoming().lgaId)))) ||
          (incoming().scopeType == 'CONSTITUENCY' && hasActiveUser() && callerDoc().role in ['FUNTUA_SUPER_ADMIN', 'DANDUME_SUPER_ADMIN', 'VERIFICATION_OFFICER'])
        );
      allow delete: if isFullControlAdmin() && isValidId(aggId);
    }

    // --- 8D. PROTECTED REPORT ATTACHMENTS ---
    match /report_attachments/{attachmentId} {
      allow get: if isVerifiedUser() && isValidId(attachmentId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().ownerUid))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().ownerUid)
      );
      allow create: if isVerifiedUser() && isValidId(attachmentId) &&
        isValidReportAttachment(incoming()) &&
        incoming().attachmentId == attachmentId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time && (
          isFullControlAdmin() ||
          canReadInArea(incoming().lgaId, incoming().wardId, incoming().puId, incoming().ownerUid)
        );
      allow update: if false;
      allow delete: if isFullControlAdmin() && isValidId(attachmentId);
    }

    // --- 9. PUBLIC VERIFIED RESULTS (NO PII) ---
    match /public_results/{puId} {
      allow get, list: if isVerifiedUser();
      allow create, update: if isFullControlAdmin() && isValidId(puId) &&
        isValidPublicResult(incoming()) &&
        incoming().approvedByUid == request.auth.uid &&
        incoming().verifiedAt == request.time;
      allow delete: if isFullControlAdmin() && isValidId(puId);
    }

    // --- 10. ELECTION DAY TIMELINE ---
    match /timeline_events/{eventId} {
      allow get, list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        canReadInArea(existing().lgaId, existing().wardId, existing().puId, existing().actorUid)
      );
      allow create: if isVerifiedUser() && isValidId(eventId) &&
        isValidTimelineEvent(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time && (
          isFullControlAdmin() || hasActiveUser()
        );
      allow update: if false;
      allow delete: if isFullControlAdmin() && isValidId(eventId);
    }

    // --- 11. NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow get, list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        (hasActiveUser() && (
          existing().targetLgaId == 'all' ||
          existing().targetLgaId == callerDoc().assignedLgaId ||
          existing().targetWardId == callerDoc().assignedWardId ||
          (callerDoc().role == 'VERIFICATION_OFFICER' && callerDoc().assignedLgaId == '')
        ))
      );
      allow create: if isVerifiedUser() && isValidId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time && (
          isFullControlAdmin() || hasActiveUser()
        );
      allow update: if false;
      allow delete: if isFullControlAdmin() && isValidId(notificationId);
    }

    // --- 11B. EMERGENCY ASSISTANCE NUMBERS (AUTHENTICATED USERS ONLY) ---
    match /emergency_contacts/{contactId} {
      allow get: if isVerifiedUser() && isValidId(contactId) && (
        isFullControlAdmin() ||
        (hasActiveUser() && (
          existing().scopeLgaId == 'all' ||
          existing().scopeLgaId == callerDoc().assignedLgaId ||
          (callerDoc().role == 'VERIFICATION_OFFICER' && callerDoc().assignedLgaId == '')
        ))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        (hasActiveUser() && (
          existing().scopeLgaId == 'all' ||
          existing().scopeLgaId == callerDoc().assignedLgaId ||
          (callerDoc().role == 'VERIFICATION_OFFICER' && callerDoc().assignedLgaId == '')
        ))
      );
      allow create: if isVerifiedUser() && isValidId(contactId) &&
        isValidEmergencyContact(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          isLgaAdminFor(incoming().scopeLgaId)
        );
      allow update: if isVerifiedUser() && isValidId(contactId) &&
        isValidEmergencyContact(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          (isLgaAdminFor(existing().scopeLgaId) && isLgaAdminFor(incoming().scopeLgaId))
        );
      allow delete: if isVerifiedUser() && isValidId(contactId) && (
        isFullControlAdmin() ||
        isLgaAdminFor(existing().scopeLgaId)
      );
    }

    // --- 11C. OPERATIONAL NOTES & SHORT FIELD MESSAGES ---
    match /operational_notes/{noteId} {
      allow get: if isVerifiedUser() && isValidId(noteId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && hasActiveUser() && (
          existing().authorUid == request.auth.uid ||
          (callerDoc().role == 'FUNTUA_SUPER_ADMIN' && existing().lgaId in ['all', 'funtua']) ||
          (callerDoc().role == 'DANDUME_SUPER_ADMIN' && existing().lgaId in ['all', 'dandume']) ||
          (callerDoc().role == 'VERIFICATION_OFFICER' && (
            callerDoc().assignedLgaId == '' ||
            (existing().lgaId == callerDoc().assignedLgaId && (callerDoc().assignedWardId == '' || existing().wardId == callerDoc().assignedWardId))
          )) ||
          (callerDoc().role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && callerDoc().assignedWardId.size() > 0 && existing().wardId == callerDoc().assignedWardId) ||
          (callerDoc().role == 'POLLING_UNIT_AGENT' && callerDoc().assignedPollingUnitId.size() > 0 && existing().puId == callerDoc().assignedPollingUnitId)
        ))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        (hasActiveUser() && (
          existing().authorUid == request.auth.uid ||
          (callerDoc().role == 'FUNTUA_SUPER_ADMIN' && existing().lgaId in ['all', 'funtua']) ||
          (callerDoc().role == 'DANDUME_SUPER_ADMIN' && existing().lgaId in ['all', 'dandume']) ||
          (callerDoc().role == 'VERIFICATION_OFFICER' && (
            callerDoc().assignedLgaId == '' ||
            (existing().lgaId == callerDoc().assignedLgaId && (callerDoc().assignedWardId == '' || existing().wardId == callerDoc().assignedWardId))
          )) ||
          (callerDoc().role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && callerDoc().assignedWardId.size() > 0 && existing().wardId == callerDoc().assignedWardId) ||
          (callerDoc().role == 'POLLING_UNIT_AGENT' && callerDoc().assignedPollingUnitId.size() > 0 && existing().puId == callerDoc().assignedPollingUnitId)
        ))
      );
      allow create: if isVerifiedUser() && isValidId(noteId) &&
        isValidOperationalNote(incoming()) &&
        incoming().clientNoteId == noteId &&
        incoming().authorUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          (hasActiveUser() && (
            (callerDoc().role == 'FUNTUA_SUPER_ADMIN' && incoming().lgaId in ['all', 'funtua']) ||
            (callerDoc().role == 'DANDUME_SUPER_ADMIN' && incoming().lgaId in ['all', 'dandume']) ||
            (callerDoc().role == 'VERIFICATION_OFFICER' && (
              callerDoc().assignedLgaId == '' ||
              incoming().lgaId == callerDoc().assignedLgaId
            )) ||
            (callerDoc().role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && callerDoc().assignedWardId.size() > 0 && incoming().wardId == callerDoc().assignedWardId) ||
            (callerDoc().role == 'POLLING_UNIT_AGENT' && (incoming().puId == '' || incoming().puId == callerDoc().assignedPollingUnitId)) ||
            (callerDoc().role == 'ORDINARY_USER' && (incoming().puId == '' || incoming().puId == callerDoc().assignedPollingUnitId))
          ))
        );
      allow update: if isVerifiedUser() && isValidId(noteId) &&
        isValidOperationalNote(incoming()) &&
        incoming().clientNoteId == existing().clientNoteId &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().revision >= existing().revision && (
          isFullControlAdmin() ||
          (hasActiveUser() && existing().authorUid == request.auth.uid)
        );
      allow delete: if isVerifiedUser() && isValidId(noteId) && (
        isFullControlAdmin() ||
        (hasActiveUser() && existing().authorUid == request.auth.uid)
      );
    }

    // --- 11D. TASK ASSIGNMENT & FIELD OPERATIONS ---
    match /operational_tasks/{taskId} {
      allow get: if isVerifiedUser() && isValidId(taskId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && (
          isLgaAdminFor(existing().lgaId) ||
          (hasActiveUser() && existing().assignedOfficerUid == request.auth.uid)
        ))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        isLgaAdminFor(existing().lgaId) ||
        (hasActiveUser() && existing().assignedOfficerUid == request.auth.uid)
      );
      allow create: if isFullControlAdmin() && isValidId(taskId) &&
        isValidOperationalTask(incoming()) &&
        incoming().assignedByUid == request.auth.uid &&
        incoming().status == 'ASSIGNED' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/wards/$(incoming().wardId)) &&
        exists(/databases/$(database)/documents/users/$(incoming().assignedOfficerUid));
      allow update: if isVerifiedUser() && isValidId(taskId) &&
        isValidOperationalTask(incoming()) &&
        incoming().assignedByUid == existing().assignedByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          (hasActiveUser() &&
            existing().assignedOfficerUid == request.auth.uid &&
            existing().status != 'APPROVED_COMPLETED' &&
            incoming().assignedOfficerUid == existing().assignedOfficerUid &&
            incoming().lgaId == existing().lgaId &&
            incoming().wardId == existing().wardId &&
            incoming().status in ['ACKNOWLEDGED', 'IN_PROGRESS', 'AWAITING_REVIEW'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'progressPercent',
              'acknowledgedAtIso',
              'submittedForReviewAtIso',
              'latestFieldReport',
              'delayReason',
              'evidenceBase64',
              'evidenceFileName',
              'serverSyncedAt',
              'updatedAt'
            ]))
        );
      allow delete: if isFullControlAdmin() && isValidId(taskId);

      match /updates/{updateId} {
        allow get, list: if isVerifiedUser() && isValidId(taskId) && (
          isFullControlAdmin() ||
          isLgaAdminFor(get(/databases/$(database)/documents/operational_tasks/$(taskId)).data.lgaId) ||
          (hasActiveUser() && get(/databases/$(database)/documents/operational_tasks/$(taskId)).data.assignedOfficerUid == request.auth.uid)
        );
        allow create: if isVerifiedUser() && isValidId(taskId) && isValidId(updateId) &&
          isValidTaskUpdateEntry(incoming(), taskId) &&
          incoming().actorUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/operational_tasks/$(taskId)) && (
            isFullControlAdmin() ||
            (hasActiveUser() &&
              get(/databases/$(database)/documents/operational_tasks/$(taskId)).data.assignedOfficerUid == request.auth.uid &&
              get(/databases/$(database)/documents/operational_tasks/$(taskId)).data.status != 'APPROVED_COMPLETED' &&
              incoming().entryType in ['OFFICER_PROGRESS', 'FIELD_REPORT', 'STATUS_CHANGE'])
          );
        allow update: if false;
        allow delete: if isFullControlAdmin() && isValidId(taskId) && isValidId(updateId);
      }
    }

    // --- 11E. ARCHIVED AUTOMATIC & ANALYTICAL REPORTS ---
    match /generated_reports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && (
          isLgaAdminFor(existing().lgaId) ||
          (hasActiveUser() && existing().generatedByUid == request.auth.uid) ||
          (hasActiveUser() && callerDoc().role == 'VERIFICATION_OFFICER' && (
            callerDoc().assignedLgaId == '' || existing().lgaId == callerDoc().assignedLgaId
          )) ||
          (hasActiveUser() && callerDoc().role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && callerDoc().assignedWardId.size() > 0 && existing().wardId == callerDoc().assignedWardId)
        ))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        isLgaAdminFor(existing().lgaId) ||
        (hasActiveUser() && existing().generatedByUid == request.auth.uid) ||
        (hasActiveUser() && callerDoc().role == 'VERIFICATION_OFFICER' && (
          callerDoc().assignedLgaId == '' || existing().lgaId == callerDoc().assignedLgaId
        )) ||
        (hasActiveUser() && callerDoc().role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && callerDoc().assignedWardId.size() > 0 && existing().wardId == callerDoc().assignedWardId)
      );
      allow create: if isVerifiedUser() && isValidId(reportId) &&
        isValidGeneratedReport(incoming()) &&
        incoming().generatedByUid == request.auth.uid &&
        incoming().createdAt == request.time && (
          isFullControlAdmin() ||
          isLgaAdminFor(incoming().lgaId) ||
          (hasActiveUser() && callerDoc().role == 'VERIFICATION_OFFICER' && (
            callerDoc().assignedLgaId == '' || incoming().lgaId == callerDoc().assignedLgaId
          )) ||
          (hasActiveUser() && callerDoc().role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && callerDoc().assignedWardId.size() > 0 && incoming().wardId == callerDoc().assignedWardId)
        );
      allow update: if isVerifiedUser() && isValidId(reportId) &&
        isValidGeneratedReport(incoming()) &&
        incoming().createdAt == existing().createdAt && (
          isFullControlAdmin() ||
          (isLgaAdminFor(existing().lgaId) && incoming().lgaId == existing().lgaId && incoming().generatedByUid == request.auth.uid)
        );
      allow delete: if isFullControlAdmin() && isValidId(reportId);
    }

    // --- 11F. STRUCTURED EMERGENCY ASSISTANCE REPORTS ---
    match /emergency_reports/{reportId} {
      allow get: if isVerifiedUser() && isValidId(reportId) && (
        isFullControlAdmin() ||
        (resource == null && hasActiveUser()) ||
        (resource != null && hasActiveUser() && (
          existing().reporterUid == request.auth.uid ||
          (callerDoc().role == 'FUNTUA_SUPER_ADMIN' && existing().lgaId in ['all', 'funtua']) ||
          (callerDoc().role == 'DANDUME_SUPER_ADMIN' && existing().lgaId in ['all', 'dandume']) ||
          (callerDoc().role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && callerDoc().assignedWardId.size() > 0 && existing().wardId == callerDoc().assignedWardId)
        ))
      );
      allow list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        (hasActiveUser() && (
          existing().reporterUid == request.auth.uid ||
          (callerDoc().role == 'FUNTUA_SUPER_ADMIN' && existing().lgaId in ['all', 'funtua']) ||
          (callerDoc().role == 'DANDUME_SUPER_ADMIN' && existing().lgaId in ['all', 'dandume']) ||
          (callerDoc().role in ['WARD_COORDINATOR', 'OPERATIONS_OFFICER'] && callerDoc().assignedWardId.size() > 0 && existing().wardId == callerDoc().assignedWardId)
        ))
      );
      allow create: if isVerifiedUser() && isValidId(reportId) &&
        hasActiveUser() &&
        isValidEmergencyReport(incoming()) &&
        incoming().reporterUid == request.auth.uid &&
        incoming().status == 'SUBMITTED' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(reportId) &&
        isValidEmergencyReport(incoming()) &&
        incoming().reporterUid == existing().reporterUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isFullControlAdmin() ||
          (isLgaAdminFor(existing().lgaId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedResponderUid', 'assignedResponderName', 'resolutionNotes', 'updatedAt']))
        );
      allow delete: if isFullControlAdmin() && isValidId(reportId);
    }

    // --- 11G. SMART NOTIFICATION ESCALATION RULES ---
    match /escalation_rules/{ruleId} {
      allow get, list: if isVerifiedUser() && (
        isFullControlAdmin() ||
        isLgaAdminFor('funtua') ||
        isLgaAdminFor('dandume')
      );
      allow create, update: if isFullControlAdmin() && isValidId(ruleId) &&
        isValidEscalationRule(incoming()) &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if isFullControlAdmin() && isValidId(ruleId);
    }

    // --- 11H. SERVER-AUTHORITATIVE PERMANENT DELETION TOMBSTONES ---
    match /deletion_tombstones/{recordId} {
      allow get, list: if hasActiveUser();
      allow create, update: if isFullControlAdmin() && isValidId(recordId) &&
        isValidDeletionTombstone(incoming()) &&
        incoming().deletedByUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow delete: if isFullControlAdmin() && isValidId(recordId);
    }

    // --- 11I. ENCRYPTED SYSTEM BACKUP LEDGER (FULL CONTROL ADMIN ONLY) ---
    match /system_backups/{backupId} {
      allow get, list: if isFullControlAdmin();
      allow create, update: if isFullControlAdmin() && isValidId(backupId) &&
        isValidSystemBackup(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow delete: if isFullControlAdmin() && isValidId(backupId);
    }

    // --- 12. IMMUTABLE AUDIT LOGS (ADMIN ONLY READ) ---
    match /audit_logs/{logId} {
      allow get, list: if isFullControlAdmin();
      allow create: if isVerifiedUser() && isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().actorUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
